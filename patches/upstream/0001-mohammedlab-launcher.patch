+	        m_main_dialog, tr("First-run setup"),
+	        TranslateLauncherText(
+	            g_interface_language, "MainDialogPrivate",
+	            "Add a game folder now? The existing launcher will scan for supported game files.")) ==
+	    QMessageBox::Yes) {
+		m_ui->widget->EnsureGameDirectory();
