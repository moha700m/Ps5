+LauncherLanguage ReadLauncherLanguage(bool* configured) {
+	auto settings = Settings();
+	settings->beginGroup(QString::fromLatin1(SETTINGS_GROUP));
+	const bool has_value = settings->contains(QString::fromLatin1(SETTINGS_KEY));
+	const auto language = settings->value(QString::fromLatin1(SETTINGS_KEY)).toString();
+	settings->endGroup();
+	if (configured != nullptr) {
+		*configured = has_value;
+	}
+	if (has_value) {
+		return language == QLatin1String("ar") ? LauncherLanguage::Arabic
+		                                      : LauncherLanguage::English;
+	}
+	return QLocale::system().language() == QLocale::Arabic ? LauncherLanguage::Arabic
+	                                                        : LauncherLanguage::English;
+}
+
+void WriteLauncherLanguage(LauncherLanguage language) {
+	auto settings = Settings();
+	settings->beginGroup(QString::fromLatin1(SETTINGS_GROUP));
+	settings->setValue(QString::fromLatin1(SETTINGS_KEY),
+	                   language == LauncherLanguage::Arabic ? QStringLiteral("ar")
+	                                                        : QStringLiteral("en"));
+	settings->endGroup();
+	settings->sync();
+}
+
+bool ReadFirstRunSetupCompleted() {
+	auto settings = Settings();
+	settings->beginGroup(QString::fromLatin1(SETTINGS_GROUP));
+	const bool completed = settings->value(QString::fromLatin1(FIRST_RUN_KEY), false).toBool();
+	settings->endGroup();
+	return completed;
+}
+
+void WriteFirstRunSetupCompleted() {
+	auto settings = Settings();
+	settings->beginGroup(QString::fromLatin1(SETTINGS_GROUP));
+	settings->setValue(QString::fromLatin1(FIRST_RUN_KEY), true);
+	settings->endGroup();
+	settings->sync();
+}
+
+void ApplyLauncherLanguage(QApplication& application, LauncherLanguage language) {
+	auto& translator = ArabicTranslator();
+	application.removeTranslator(&translator);
+	application.setLayoutDirection(language == LauncherLanguage::Arabic ? Qt::RightToLeft
+	                                                                    : Qt::LeftToRight);
+	if (language == LauncherLanguage::Arabic) {
+		application.installTranslator(&translator);
+	}
+}
+
+QString TranslateLauncherText(LauncherLanguage language, const char* context, const char* source) {
+	if (language != LauncherLanguage::Arabic) {
+		return QString::fromUtf8(source);
+	}
+	return ArabicTranslations().value(TranslationKey(context, source), QString::fromUtf8(source));
+}
