diff --git a/src/launcher/src/controllerTestDialog.cpp b/src/launcher/src/controllerTestDialog.cpp
new file mode 100644
index 0000000..7800765
--- /dev/null
+++ b/src/launcher/src/controllerTestDialog.cpp
@@ -0,0 +1,103 @@
+#include "controllerTestDialog.h"
+
+#include <SDL3/SDL.h>
+
+#include <QLabel>
+#include <QTimer>
+#include <QVBoxLayout>
+
+ControllerTestDialog::ControllerTestDialog(QWidget* parent): QDialog(parent) {
+	setWindowTitle(tr("Controller test"));
+	resize(480, 300);
+	auto* layout = new QVBoxLayout(this);
+	m_status = new QLabel(this);
+	m_status->setWordWrap(true);
+	m_state = new QLabel(this);
+	m_state->setTextInteractionFlags(Qt::TextSelectableByMouse);
+	layout->addWidget(m_status);
+	layout->addWidget(m_state);
+
+	m_sdl_initialized = SDL_InitSubSystem(SDL_INIT_GAMEPAD);
+	if (!m_sdl_initialized) {
+		m_status->setText(tr("SDL could not initialize gamepad input: %1")
+		                      .arg(QString::fromUtf8(SDL_GetError())));
+		return;
+	}
+	m_status->setText(tr("Connect a controller. Values below are live SDL gamepad events; "
+	                     "this screen does not verify in-game input or haptics."));
+	m_timer = new QTimer(this);
+	connect(m_timer, &QTimer::timeout, this, &ControllerTestDialog::Refresh);
+	m_timer->start(50);
+	Refresh();
+}
+
+ControllerTestDialog::~ControllerTestDialog() {
+	if (m_timer != nullptr) {
+		m_timer->stop();
+	}
+	CloseGamepad();
+	if (m_sdl_initialized) {
+		SDL_QuitSubSystem(SDL_INIT_GAMEPAD);
+	}
+}
+
+void ControllerTestDialog::CloseGamepad() {
+	if (m_gamepad != nullptr) {
+		SDL_CloseGamepad(m_gamepad);
+		m_gamepad = nullptr;
+	}
+}
+
+void ControllerTestDialog::Refresh() {
+	SDL_PumpEvents();
+	if (m_gamepad != nullptr && !SDL_GamepadConnected(m_gamepad)) {
+		CloseGamepad();
+	}
+	if (m_gamepad == nullptr) {
+		int count = 0;
+		SDL_JoystickID* devices = SDL_GetGamepads(&count);
+		if (devices != nullptr && count > 0) {
+			m_gamepad = SDL_OpenGamepad(devices[0]);
+		}
+		SDL_free(devices);
+	}
+	if (m_gamepad == nullptr) {
+		m_status->setText(tr("No SDL gamepad detected. Connect a supported controller."));
+		m_state->clear();
+		return;
+	}
+
+	m_status->setText(tr("Connected: %1 (%2)")
+	                      .arg(QString::fromUtf8(SDL_GetGamepadName(m_gamepad)),
+	                           QString::fromUtf8(SDL_GetGamepadPath(m_gamepad)
+	                                                 ? SDL_GetGamepadPath(m_gamepad)
+	                                                 : "")));
+	QStringList values;
+	const auto add_axis = [this, &values](const char* name, SDL_GamepadAxis axis) {
+		values << QStringLiteral("%1: %2").arg(QString::fromLatin1(name))
+		                                    .arg(SDL_GetGamepadAxis(m_gamepad, axis));
+	};
+	add_axis("Left X", SDL_GAMEPAD_AXIS_LEFTX);
+	add_axis("Left Y", SDL_GAMEPAD_AXIS_LEFTY);
+	add_axis("Right X", SDL_GAMEPAD_AXIS_RIGHTX);
+	add_axis("Right Y", SDL_GAMEPAD_AXIS_RIGHTY);
+	add_axis("Left trigger", SDL_GAMEPAD_AXIS_LEFT_TRIGGER);
+	add_axis("Right trigger", SDL_GAMEPAD_AXIS_RIGHT_TRIGGER);
+	const struct {
+		const char*     name;
+		SDL_GamepadButton button;
+	} buttons[] = {
+	    {"South", SDL_GAMEPAD_BUTTON_SOUTH}, {"East", SDL_GAMEPAD_BUTTON_EAST},
+	    {"West", SDL_GAMEPAD_BUTTON_WEST},   {"North", SDL_GAMEPAD_BUTTON_NORTH},
+	    {"Back", SDL_GAMEPAD_BUTTON_BACK},   {"Start", SDL_GAMEPAD_BUTTON_START},
+	    {"L1", SDL_GAMEPAD_BUTTON_LEFT_SHOULDER},
+	    {"R1", SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER},
+	};
+	for (const auto& item: buttons) {
+		values << QStringLiteral("%1: %2")
+		              .arg(QString::fromLatin1(item.name),
+		                   SDL_GetGamepadButton(m_gamepad, item.button) ? tr("pressed")
+		                                                               : tr("released"));
+	}
+	m_state->setText(values.join(QStringLiteral("\n")));
+}
diff --git a/src/launcher/src/hardwareDiagnostics.cpp b/src/launcher/src/hardwareDiagnostics.cpp
new file mode 100644
index 0000000..612dd56
--- /dev/null
+++ b/src/launcher/src/hardwareDiagnostics.cpp
@@ -0,0 +1,279 @@
+#include "hardwareDiagnostics.h"
+
+#include <vulkan/vulkan.h>
+
+#include <QCoreApplication>
+#include <QLibrary>
+#include <QSysInfo>
+#include <QStorageInfo>
+#include <QStringList>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <vector>
+
+RendererSupport ClassifyRendererSupport(bool has_device, bool api_supported,
+                                        bool required_features_supported,
+                                        bool surface_checked, bool surface_supported) {
+	if (!has_device) {
+		return RendererSupport::Unknown;
+	}
+	if (!api_supported || !required_features_supported ||
+	    (surface_checked && !surface_supported)) {
+		return RendererSupport::Unsupported;
+	}
+	if (!surface_checked) {
+		return RendererSupport::Unknown;
+	}
+	return RendererSupport::Supported;
+}
+
+namespace {
+
+QString Label(LauncherLanguage language, const char* english, const char* arabic) {
+	return language == LauncherLanguage::Arabic ? QString::fromUtf8(arabic)
+	                                            : QString::fromUtf8(english);
+}
+
+QString VulkanVersion(uint32_t version) {
+	return QStringLiteral("%1.%2.%3")
+	    .arg(VK_VERSION_MAJOR(version))
+	    .arg(VK_VERSION_MINOR(version))
+	    .arg(VK_VERSION_PATCH(version));
+}
+
+} // namespace
+
+QString CollectHardwareDiagnostics(LauncherLanguage language) {
+	QStringList lines;
+	lines << Label(language, "Operating system: ", "نظام التشغيل: ") +
+	             QSysInfo::prettyProductName();
+	lines << Label(language, "Architecture: ", "المعمارية: ") +
+	             QSysInfo::currentCpuArchitecture();
+#if defined(_WIN32)
+	MEMORYSTATUSEX memory {};
+	memory.dwLength = sizeof(memory);
+	if (GlobalMemoryStatusEx(&memory)) {
+		lines << Label(language, "Physical RAM: ", "الذاكرة الفعلية: ") +
+		             QString::number(memory.ullTotalPhys / (1024 * 1024)) + QStringLiteral(" MiB");
+	}
+#endif
+	const QStorageInfo storage(QCoreApplication::applicationDirPath());
+	if (storage.isValid() && storage.isReady()) {
+		lines << Label(language, "Free storage beside the launcher: ",
+		               "المساحة المتاحة بجانب المشغّل: ") +
+		             QString::number(storage.bytesAvailable() / (1024 * 1024)) +
+		             QStringLiteral(" MiB");
+	}
+
+#if defined(_WIN32)
+	QLibrary vulkan(QStringLiteral("vulkan-1"));
+#elif defined(__APPLE__)
+	QLibrary vulkan(QStringLiteral("vulkan"));
+#else
+	QLibrary vulkan(QStringLiteral("vulkan"));
+#endif
+	if (!vulkan.load()) {
+		lines << Label(language,
+		               "Vulkan loader: unavailable; GPU compatibility is unknown. Install or update "
+		               "a vendor Vulkan driver, then retry.",
+		               "مشغّل Vulkan: غير متاح؛ توافق بطاقة الرسومات غير معروف. ثبّت أو حدّث "
+		               "تعريف Vulkan من الشركة المصنّعة ثم أعد المحاولة.");
+		return lines.join(QLatin1Char('\n'));
+	}
+
+	auto get_instance_proc_addr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+	    vulkan.resolve("vkGetInstanceProcAddr"));
+	auto create_instance = reinterpret_cast<PFN_vkCreateInstance>(
+	    vulkan.resolve("vkCreateInstance"));
+	if (get_instance_proc_addr == nullptr || create_instance == nullptr) {
+		lines << Label(language, "Vulkan loader is incomplete; device status is unknown.",
+		               "مشغّل Vulkan غير مكتمل؛ حالة الجهاز غير معروفة.");
+		return lines.join(QLatin1Char('\n'));
+	}
+
+	uint32_t loader_version = VK_API_VERSION_1_0;
+	auto enumerate_instance_version = reinterpret_cast<PFN_vkEnumerateInstanceVersion>(
+	    vulkan.resolve("vkEnumerateInstanceVersion"));
+	if (enumerate_instance_version != nullptr &&
+	    enumerate_instance_version(&loader_version) != VK_SUCCESS) {
+		loader_version = VK_API_VERSION_1_0;
+	}
+	lines << Label(language, "Vulkan loader version: ", "إصدار مشغّل Vulkan: ") +
+	             VulkanVersion(loader_version);
+
+	VkApplicationInfo application {};
+	application.sType              = VK_STRUCTURE_TYPE_APPLICATION_INFO;
+	application.pApplicationName   = "MohammedLab PS5 diagnostics";
+	application.apiVersion         = std::min(loader_version, VK_API_VERSION_1_3);
+	VkInstanceCreateInfo instance_info {};
+	instance_info.sType            = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
+	instance_info.pApplicationInfo = &application;
+	VkInstance instance = VK_NULL_HANDLE;
+	if (create_instance(&instance_info, nullptr, &instance) != VK_SUCCESS) {
+		lines << Label(language, "Vulkan instance creation failed; device status is unknown.",
+		               "تعذر إنشاء مثيل Vulkan؛ حالة الجهاز غير معروفة.");
+		return lines.join(QLatin1Char('\n'));
+	}
+
+	auto destroy_instance = reinterpret_cast<PFN_vkDestroyInstance>(
+	    get_instance_proc_addr(instance, "vkDestroyInstance"));
+	auto enumerate_devices = reinterpret_cast<PFN_vkEnumeratePhysicalDevices>(
+	    get_instance_proc_addr(instance, "vkEnumeratePhysicalDevices"));
+	auto get_properties = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(
+	    get_instance_proc_addr(instance, "vkGetPhysicalDeviceProperties"));
+	auto get_features = reinterpret_cast<PFN_vkGetPhysicalDeviceFeatures2>(
+	    get_instance_proc_addr(instance, "vkGetPhysicalDeviceFeatures2"));
+	auto enumerate_extensions = reinterpret_cast<PFN_vkEnumerateDeviceExtensionProperties>(
+	    get_instance_proc_addr(instance, "vkEnumerateDeviceExtensionProperties"));
+	if (destroy_instance == nullptr || enumerate_devices == nullptr || get_properties == nullptr ||
+	    get_features == nullptr || enumerate_extensions == nullptr) {
+		if (destroy_instance != nullptr) {
+			destroy_instance(instance, nullptr);
+		}
+		lines << Label(language, "Vulkan device query functions are unavailable; status is unknown.",
+		               "وظائف فحص أجهزة Vulkan غير متاحة؛ الحالة غير معروفة.");
+		return lines.join(QLatin1Char('\n'));
+	}
+
+	uint32_t device_count = 0;
+	if (enumerate_devices(instance, &device_count, nullptr) != VK_SUCCESS || device_count == 0) {
+		destroy_instance(instance, nullptr);
+		lines << Label(language, "No Vulkan physical device was enumerated.",
+		               "لم يتم العثور على جهاز Vulkan فعلي.");
+		lines << Label(language,
+		               "Renderer status: unknown; no device was enumerated, so GPU absence and "
+		               "driver/runtime availability cannot be distinguished here.",
+		               "حالة العرض: غير معروفة؛ لم يظهر جهاز، ولا يمكن التمييز هنا بين غياب "
+		               "البطاقة وغياب التعريف أو بيئة التشغيل.");
+		return lines.join(QLatin1Char('\n'));
+	}
+	std::vector<VkPhysicalDevice> devices(device_count);
+	if (enumerate_devices(instance, &device_count, devices.data()) != VK_SUCCESS) {
+		destroy_instance(instance, nullptr);
+		lines << Label(language, "Vulkan device enumeration failed; status is unknown.",
+		               "فشل تعداد أجهزة Vulkan؛ الحالة غير معروفة.");
+		return lines.join(QLatin1Char('\n'));
+	}
+
+	const std::array<const char*, 8> required_extensions {
+	    VK_KHR_SWAPCHAIN_EXTENSION_NAME,
+	    VK_EXT_DEPTH_CLIP_CONTROL_EXTENSION_NAME,
+	    VK_EXT_IMAGE_VIEW_MIN_LOD_EXTENSION_NAME,
+	    VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME,
+	    "VK_KHR_maintenance1",
+	    VK_EXT_DEPTH_CLIP_ENABLE_EXTENSION_NAME,
+	    VK_EXT_COLOR_WRITE_ENABLE_EXTENSION_NAME,
+	    VK_KHR_FRAGMENT_SHADER_BARYCENTRIC_EXTENSION_NAME,
+	};
+
+	for (uint32_t index = 0; index < device_count; ++index) {
+		VkPhysicalDeviceProperties properties {};
+		get_properties(devices[index], &properties);
+		lines << QStringLiteral("GPU %1: %2")
+		              .arg(index)
+		              .arg(QString::fromUtf8(properties.deviceName));
+		lines << Label(language, "  Vulkan API: ", "  واجهة Vulkan: ") +
+		             VulkanVersion(properties.apiVersion);
+		lines << Label(language, "  Driver version (raw): ", "  إصدار التعريف (خام): ") +
+		             QString::number(properties.driverVersion);
+
+		VkPhysicalDeviceVulkan12Features features12 {};
+		features12.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES;
+		VkPhysicalDeviceVulkan13Features features13 {};
+		features13.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES;
+		features12.pNext = &features13;
+		VkPhysicalDeviceDepthClipControlFeaturesEXT depth_clip_control {};
+		depth_clip_control.sType =
+		    VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DEPTH_CLIP_CONTROL_FEATURES_EXT;
+		VkPhysicalDeviceImageViewMinLodFeaturesEXT image_view_min_lod {};
+		image_view_min_lod.sType =
+		    VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_VIEW_MIN_LOD_FEATURES_EXT;
+		VkPhysicalDeviceDepthClipEnableFeaturesEXT depth_clip_enable {};
+		depth_clip_enable.sType =
+		    VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DEPTH_CLIP_ENABLE_FEATURES_EXT;
+		VkPhysicalDeviceColorWriteEnableFeaturesEXT color_write_enable {};
+		color_write_enable.sType =
+		    VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COLOR_WRITE_ENABLE_FEATURES_EXT;
+		VkPhysicalDeviceFragmentShaderBarycentricFeaturesKHR barycentric {};
+		barycentric.sType =
+		    VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADER_BARYCENTRIC_FEATURES_KHR;
+		features13.pNext         = &depth_clip_control;
+		depth_clip_control.pNext = &image_view_min_lod;
+		image_view_min_lod.pNext = &depth_clip_enable;
+		depth_clip_enable.pNext  = &color_write_enable;
+		color_write_enable.pNext = &barycentric;
+		VkPhysicalDeviceFeatures2 features {};
+		features.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+		features.pNext = &features12;
+		const bool api_ok = properties.apiVersion >= VK_API_VERSION_1_3;
+		if (api_ok) {
+			get_features(devices[index], &features);
+		}
+		const bool feature_ok =
+		    features.features.depthClamp && features.features.sampleRateShading &&
+		    features.features.depthBiasClamp && features.features.shaderClipDistance &&
+		    features.features.shaderCullDistance && features.features.largePoints &&
+		    features.features.multiViewport && features.features.fillModeNonSolid &&
+		    features.features.fragmentStoresAndAtomics && features.features.samplerAnisotropy &&
+		    features.features.robustBufferAccess && features.features.depthBounds &&
+		    features.features.shaderStorageImageWriteWithoutFormat &&
+		    features.features.shaderImageGatherExtended && features.features.independentBlend &&
+		    features.features.tessellationShader && features12.samplerMirrorClampToEdge &&
+		    features12.timelineSemaphore && features12.shaderOutputLayer &&
+		    features12.shaderOutputViewportIndex && features12.bufferDeviceAddress &&
+		    features12.shaderBufferInt64Atomics && features13.robustImageAccess &&
+		    features13.dynamicRendering && features13.synchronization2 &&
+		    depth_clip_control.depthClipControl && image_view_min_lod.minLod &&
+		    depth_clip_enable.depthClipEnable && color_write_enable.colorWriteEnable &&
+		    barycentric.fragmentShaderBarycentric;
+		uint32_t extension_count = 0;
+		enumerate_extensions(devices[index], nullptr, &extension_count, nullptr);
+		std::vector<VkExtensionProperties> extensions(extension_count);
+		enumerate_extensions(devices[index], nullptr, &extension_count, extensions.data());
+		bool extensions_ok = true;
+		for (const auto* required: required_extensions) {
+			const bool found = std::any_of(extensions.begin(), extensions.end(),
+			                               [required](const auto& extension) {
+				                               return strcmp(extension.extensionName, required) == 0;
+			                               });
+			if (!found) {
+				extensions_ok = false;
+				lines << Label(language, "  Missing required extension: ",
+				               "  الامتداد المطلوب غير متوفر: ") +
+				             QString::fromLatin1(required);
+			}
+		}
+		const bool requirements_ok = api_ok && feature_ok && extensions_ok;
+		if (!api_ok) {
+			lines << Label(language, "  Vulkan 1.3 is required by the renderer.",
+			               "  يتطلب محرك العرض Vulkan 1.3.");
+		}
+		if (!feature_ok) {
+			lines << Label(language, "  One or more required Vulkan features are unavailable.",
+			               "  ميزة أو أكثر من ميزات Vulkan المطلوبة غير متاحة.");
+		}
+		const auto status = ClassifyRendererSupport(true, api_ok, feature_ok && extensions_ok,
+		                                           false, false);
+		lines << Label(language, "  Baseline capability status: ",
+		               "  حالة الإمكانات الأساسية: ") +
+		             (status == RendererSupport::Unsupported
+		                  ? Label(language, "unsupported", "غير مدعوم")
+		                  : Label(language, "unknown; presentation/format checks remain",
+		                          "غير معروف؛ لم تُفحص إمكانات العرض والتنسيقات"));
+		if (requirements_ok) {
+			lines << Label(language, "  Required API/features/extensions found.",
+			               "  وُجدت الواجهة والميزات والامتدادات المطلوبة.");
+		}
+	}
+	destroy_instance(instance, nullptr);
+	return lines.join(QLatin1Char('\n'));
+}
